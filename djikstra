#include <bits/stdc++.h>
using namespace std;

vector<int> djikstra(vector<vector<pair<int,int>>>& arr, int start) {
    int s = arr.size();
    priority_queue<pair<int,int>, vector<pair<int,int>>, greater<pair<int,int>>> pq;
    vector<int> dist(s, INT_MAX);
    dist[start]=0;
    pq.emplace(0,start);
    while (!pq.empty()) {
        auto top = pq.top();
        pq.pop();
        int v = top.first;
        int u = top.second;
        if (v>dist[u]) {
            continue;
        }
        for (auto &p : arr[u]) {
            int a = p.first;
            int b = p.second;
            if (dist[u]+b < dist[a]) {
                dist[a] = dist[u]+b;
                pq.emplace(dist[a],a);
            }
        }
    }
    return dist;
}

int main() {
    int m,n;
    cin>>m>>n;
    int maxNode=0;
    vector<tuple<int,int,int>> edges;
    for (int i=0;i<n;i++) {
        int a,b,tezina;
        cin>>a>>b>>tezina;
        edges.push_back({a,b,tezina});
        maxNode = max(maxNode, max(a,b));
    }
    vector<vector<pair<int,int>>> graf(maxNode+1);
    for (auto &[a,b,tezina] : edges) {
        graf[a].push_back({b,tezina});
        graf[b].push_back({a,tezina});
    }
    int start = 1;
    vector<int> dist = djikstra(graf,start);
    for (int i=1;i<=maxNode;i++) {
        cout<<"distanca od 1 do "<<i<<" "<<dist[i]<<endl;
    }
}


