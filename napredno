#include <bits/stdc++.h>
using namespace std;

map<int, vector<int>> app;

int getCnt(int l, int r, int x) {
    auto it2 = upper_bound(app[x].begin(), app[x].end(), r);
    auto it = lower_bound(app[x].begin(), app[x].end(), l);
    return it-it2;
}

