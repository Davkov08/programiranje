#include <bits/stdc++.h>
using namespace std;

vector<int> val, sumv, mn, mx;

void dfs(int start, vector<vector<int>>& arr, vector<bool>& visited) {
    visited[start]=true;
    sumv[start] = val[start];
    mn[start] = val[start];
    mx[start] = val[start];
    //cout<<start<<" ";
    for (auto x : arr[start]) {
        if (!visited[x]) {
            dfs(x,arr,visited);
            sumv[start] += sumv[x];
            mn[start] = min(mn[x],mn[start]);
            mx[start] = max(mx[x],mx[start]);
        }
    }
}

int main() {
    int n;
    cin>>n;
    vector<vector<int>> arr(n);
    val.resize(n);
    sumv.resize(n);
    mn.resize(n);
    mx.resize(n);
    for (int i=0;i<n;i++) {
        cin>>val[i];
    }
    for (int i=0;i<n-1;i++) {
        int a,b;
        cin>>a>>b;
        arr[a].push_back(b);
        arr[b].push_back(a);
    }
    vector<bool>visited(n,false);
    dfs(0,arr,visited);
    for (int i=0;i<n;i++) {
        cout<<sumv[i]<<" "<<mn[i]<<" "<<mx[i]<<endl;
    }
}

