#include <bits/stdc++.h>
using namespace std;
struct node{
    int value;
    node* left;
    node* right;
    node(int val){
        value = val;
        left = right = nullptr;
    }
};
struct bst{
    node* root;
    bst(){root=nullptr;};
    node* insert(node* curr, int val){
        if(curr==nullptr) return new node(val);
        if(val < curr->value) curr->left = insert(curr->left, val);
        if(val > curr->value) curr->right = insert(curr->right, val);
        return curr;
    }
    void insert(int n){root=insert(root,n);}

    bool find(node* curr, int val){
        if(curr == nullptr) return false;
        if(curr->value == val) return true;
        if(val < curr->value) return find(curr->left, val);
        else if(val > curr->value) return find(curr->right, val);
    }
    bool find(int val){return find(root, val);}

    int sum(node* curr){
        if(curr == nullptr) return 0;
        return curr->value + sum(curr->left) + sum(curr->right);
    }
    int sum(int val){return sum(root);}

    void bfs(){
        if(root == nullptr) return;
        queue<node*> q;
        q.push(root);
        if(!q.empty()){
            node* curr = q.front();
            q.pop();
            cout<<curr->value<<" ";
            if(curr->left != nullptr) q.push(curr->left);
            if(curr->right != nullptr) q.push(curr->right);
        }
    }

    void print_preorder(node* curr){
        if(curr != nullptr){
            cout<<curr->value<<" ";
            print_preorder(curr->left);
            print_preorder(curr->right);
        }
    }
    void print_inorder(node* curr){
        if(curr != nullptr){
            print_inorder(curr->left);
            cout<<curr->value<<" ";
            print_inorder(curr->right);
        }
    }
    void print_postorder(node* curr){
        if(curr != nullptr){
            print_postorder(curr->left);
            print_postorder(curr->right);
            cout<<curr->value<<" ";
        }
    }
};
class unifind{
public:
    vector<int> parent, siz, rang;
    unifind(int n){
        parent.resize(n);
        siz.resize(n, 1);
        rang.resize(n, 0);
        for(int i=0;i<n;i++){
            parent[i] = i;
        }
    }
    int find(int x){
        if(x != parent[x]){
            parent[x] = find(parent[x]);
        }
        return parent[x];
    }
    void unite(int x, int y){
        int rootx = find(x);
        int rooty = find(y);
        if(rootx == rooty) return;
        if(rootx != rooty){
            if(siz[rootx] < siz[rooty])
                swap(rootx, rooty);
        parent[rooty] = rootx;
        siz[rootx] += siz[rooty];
        }
    }
    void unite_r(int x, int y){
        int rootx = find(x);
        int rooty = find(y);
        if(rootx != rooty){
            if(rang[rootx] < rang[rooty]){
                parent[rootx] = rooty;
            }
            else if(rang[rootx] > rang[rooty]){
                parent[rooty] = rootx;
            }
            else{
                parent[rooty] = rootx;
                rang[rootx]++;
            }
        }
    }
    void print_info(int i){
        int root = find(i);
        cout<<"Node "<<i<<": parent="<<parent[root]<<" size="<<siz[root]<<" rang="<<rang[root]<<endl;
    }
    void print_all(int n){
        for(int i=0;i<n;i++){
            print_info(i);
        }
    }
};
int main(){
    bst t;
    int n,a;
    cin>>n;
    int br=n;
    while(n--){
        cin>>a;
        t.insert(a);
    }
    t.print_preorder(t.root);
    cout<<endl;
    t.print_inorder(t.root);
    cout<<endl;
    t.print_postorder(t.root);
    cout<<endl;

    cout<< (t.find(3) ? "yes" : "no") <<endl;

    cout<< t.sum(t.root) <<endl;

    t.bfs();
    cout<<endl;

    unifind uf(br);
    uf.unite(0,1);
    uf.unite(1,2);
    uf.unite(3,4);

    uf.print_all(br);
}
