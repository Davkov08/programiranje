#include <bits/stdc++.h>
using namespace std;

int doublefac(int n){
    if(n<=1) return 1;
    return n*doublefac(n-2);
}

int reversed(int n, int rev=0){
    if(n==0) return rev;
    return reversed(n/10, rev*10+(n%10));
}

void elka(int t, int n, int i, int j){
    if(t==1){
        if(j>i)
            return;
        cout<<j<<" ";
        elka(t,n,i,j+1);
    }
    else if(t==2){
        if(j==0)
            return;
        cout<<j<<" ";
        elka(t,n,i,j-1);
    }
    else if(t==3){
        if(j<=n){
            if(j==i){
                cout<<j<<" ";
                elka(t,n,i,j+1);
            }
        }
    }
    else if(t==4){
        if(j<=i){
            cout<<j<<" ";
            elka(t,n,i,j+1);
        }
        else if(j<=n-1){
            cout<<(n-(j-i))<<" ";
            elka(t,n,i,j+1);
        }
        else if(j==n){
            cout<<n<<" ";
          }
    }
}

int brojac=2;
void rek1(int n) {
    if(n==1){
        cout<<2<<" "<<1<<" ";
        return;
    }
    cout<<2*n<<" "<<2*n-1<<" ";
    rek1(n-1);
    if (brojac<=n) {
        cout<<brojac<<" ";
        brojac++;
    }
}

bool pal(const string &s, int l, int r){
    if(l >= r) return true;
    if(s[l] != s[r]) return false;
    return pal(s, l+1, r-1);
}

int main() {
    int n,a;
    string b;
    cin>>n>>a>>b;
    cout<<doublefac(n)<<"\n";
    cout<<reversed(a)<<"\n";
    rek1(n);
    cout<<"\n";
    cout<<pal(b,0,b.size()-1)<<"\n";
}
