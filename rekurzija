#include <bits/stdc++.h>
using namespace std;

int doublefac(int n){
    if(n<=1) return 1;
    return n*doublefac(n-2);
}

int reversed(int n, int rev=0){
    if(n==0) return rev;
    return reversed(n/10, rev*10+(n%10));
}

void print_gore(int a, int b) {
    if (a>b) return;
    cout<<a<<" ";
    print_gore(a+1,b);
}

void print_dole(int a, int b) {
    if (a<b) return;
    cout<<a<<" ";
    print_dole(a-1,b);
}

void print_gore1(int i, int n) {
    if (i>n) return;
    cout<<i<<" ";
    print_gore1(i+1, n);
}


void print_dole1(int i, int n) {
    if (i>n) return;
    print_gore1(i+1, n);
    cout<<i<<" ";
}

void elka(int n, int t, int i=1){
    if (t==1 && i>2*n-1) return;
    if (t==2 && i>2*n-1) return;
    if (t==3 && i>2*n-1) return;
    if (t==4 && i>2*n-1) return;

    int red = (i<=n ? i : (2*n-1));
    if (t==1) {
        print_gore(1,red);
        cout<<"\n";
    }
    if (t==2) {
        print_dole(red,1);
        cout<<"\n";
    }
    if (t==3) {
        int start = (i<=n ? n-red+1 : red);
        print_gore1(start,n);
        cout<<"\n";
    }
    if (t==4) {
        int start = (i<=n ? n-red+1 : red);
        print_dole1(start,n);
        cout<<"\n";
    }

    elka(n, t, i+1);
}

int brojac=2;
void rek1(int n) {
    if(n==1){
        cout<<2<<" "<<1<<" ";
        return;
    }
    cout<<2*n<<" "<<2*n-1<<" ";
    rek1(n-1);
    if (brojac<=n) {
        cout<<brojac<<" ";
        brojac++;
    }
}

bool pal(const string &s, int l, int r){
    if(l >= r) return true;
    if(s[l] != s[r]) return false;
    return pal(s, l+1, r-1);
}

int main() {
    int n,a;
    string b;
    cin>>n>>a>>b;
    cout<<doublefac(n)<<"\n";
    cout<<reversed(a)<<"\n";
    elka(5,1);
    elka(5,2);
    elka(5,3);
    elka(5,4);
    rek1(n);
    cout<<"\n";
    cout<<pal(b,0,b.size()-1)<<"\n";
}
