#include <bits/stdc++.h>
using namespace std;

struct Point2D {
    double x, y;
};

double dist2D(const Point2D &a, const Point2D &b) {
    return sqrt((a.x - b.x)*(a.x - b.x) + (a.y - b.y)*(a.y - b.y));
}

double bruteForce2D(vector<Point2D> &pts, int l, int r) {
    double mn = DBL_MAX;
    for (int i = l; i <= r; i++) {
        for (int j = i + 1; j <= r; j++) {
            mn = min(mn, dist2D(pts[i], pts[j]));
        }
    }
    return mn;
}

double stripClosest2D(vector<Point2D> &strip, double d) {
    double mn = d;
    sort(strip.begin(), strip.end(), [](auto &a, auto &b){ return a.y < b.y; });

    for (int i = 0; i < strip.size(); i++) {
        for (int j = i + 1; j < strip.size() && (strip[j].y - strip[i].y) < mn; j++) {
            mn = min(mn, dist2D(strip[i], strip[j]));
        }
    }
    return mn;
}

double closestUtil2D(vector<Point2D> &pts, int l, int r) {
    if (r - l <= 3)
        return bruteForce2D(pts, l, r);

    int mid = (l + r) / 2;
    Point2D midPoint = pts[mid];

    double dl = closestUtil2D(pts, l, mid);
    double dr = closestUtil2D(pts, mid + 1, r);

    double d = min(dl, dr);

    vector<Point2D> strip;
    for (int i = l; i <= r; i++) {
        if (abs(pts[i].x - midPoint.x) < d)
            strip.push_back(pts[i]);
    }

    return min(d, stripClosest2D(strip, d));
}

double closestPair2D(vector<Point2D> &pts) {
    sort(pts.begin(), pts.end(), [](auto &a, auto &b){ return a.x < b.x; });

    return closestUtil2D(pts, 0, pts.size() - 1);
}

struct Point3D {
    double x, y, z;
};

double dist3D(const Point3D &a, const Point3D &b) {
    return sqrt((a.x - b.x)*(a.x - b.x) + (a.y - b.y)*(a.y - b.y) + (a.z - b.z)*(a.z - b.z));
}

double bruteForce3D(vector<Point3D> &pts, int l, int r) {
    double mn = DBL_MAX;
    for (int i = l; i <= r; i++) {
        for (int j = i + 1; j <= r; j++) {
            mn = min(mn, dist3D(pts[i], pts[j]));
        }
    }
    return mn;
}

double stripClosest3D(vector<Point3D> &strip, double d) {
    double mn = d;

    sort(strip.begin(), strip.end(), [](auto &a, auto &b) {
        if (a.y == b.y) return a.z < b.z;
        return a.y < b.y;
    });

    for (int i = 0; i < strip.size(); i++) {
        for (int j = i + 1; j < strip.size() && (strip[j].y - strip[i].y) < mn; j++) {
            mn = min(mn, dist3D(strip[i], strip[j]));
        }
    }
    return mn;
}

double closestUtil3D(vector<Point3D> &pts, int l, int r) {
    if (r - l <= 3)
        return bruteForce3D(pts, l, r);

    int mid = (l + r) / 2;
    Point3D midPoint = pts[mid];

    double dl = closestUtil3D(pts, l, mid);
    double dr = closestUtil3D(pts, mid + 1, r);

    double d = min(dl, dr);

    vector<Point3D> strip;
    for (int i = l; i <= r; i++) {
        if (abs(pts[i].x - midPoint.x) < d)
            strip.push_back(pts[i]);
    }

    return min(d, stripClosest3D(strip, d));
}

double closestPair3D(vector<Point3D> &pts) {
    sort(pts.begin(), pts.end(), [](auto &a, auto &b){ return a.x < b.x; });

    return closestUtil3D(pts, 0, pts.size() - 1);
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int dim;
    cin >> dim;   // 2 za 2D, 3 za 3D

    int n;
    cin >> n;

    if (n < 2) {
        cout << "0\n";
        return 0;
    }

    if (dim == 2) {
        vector<Point2D> pts(n);
        for (int i = 0; i < n; i++) {
            cin >> pts[i].x >> pts[i].y;
        }

        cout << fixed << setprecision(6) << closestPair2D(pts) << "\n";

    } else if (dim == 3) {
        vector<Point3D> pts(n);
        for (int i = 0; i < n; i++) {
            cin >> pts[i].x >> pts[i].y >> pts[i].z;
        }

        cout << fixed << setprecision(6) << closestPair3D(pts) << "\n";
    }

    return 0;
}

