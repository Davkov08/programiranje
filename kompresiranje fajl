#include <bits/stdc++.h>
using namespace std;

void encodeChar(unsigned char ch, vector<bool>& compressed) {
    int count = static_cast<int>(ch); // za ASCII vrednost na sekoj karakter

    for (int i = 0; i < count; i++)
        compressed.push_back(true); //stavame kecovi kolku sto e indexot = a=0, b=10, c=110...

    compressed.push_back(false); //stavame nula na kraj za da znaeme koga sme procitale eden cel karakter
}

string decode(const vector<bool>& data) {
    string result;
    int count = 0;

    for (bool bit : data) {
        if (bit)
            count++;
        else { //koga ke najde 0 zavrsuva
            result += static_cast<char>(count);
            count = 0;
        }
    }

    return result;
}

int main() {
    ifstream inputFile("pg1399.txt", ios::binary);

    if (!inputFile) {
        cout << "nema file."<<"\n";
        return 1;
    }

    vector<bool> compressed;
    char ch;

    while (inputFile.get(ch)) {
        encodeChar(static_cast<unsigned char>(ch), compressed);
    }
    inputFile.close();
    cout << "Originalna golemina: " << compressed.size() << endl;
    string decoded = decode(compressed);
    cout << "Kompresirana golemina: " << decoded.size() << endl;
}
