void sorted_insert(LinkedList l, int value) {
    Node* p = l.head;
    Node* q = p->next;
    while (p->next) {
        if (p->next > q->next) {
            p = p->next;
        }
        else {
            p = q->next;
        }
    }
    addNode(p, value);
}




