#include <bits/stdc++.h>
using namespace std;

struct Node {
    int value;
    Node *next;
};

struct LinkedList {
    Node* head;
};

void addNode(Node* , int);
void insert(LinkedList , int);
void removeNode(LinkedList , int , bool = false);

void insert(LinkedList l, int value) {
    Node* p = l.head;
    while (p->next) {
        p = p->next;
    }
    addNode(p, value);
}

void addNode(Node* node, int val) {
    Node* newNode = new Node();
    newNode -> value = val;
    node -> next = newNode -> next;
    node -> next = newNode;
}
