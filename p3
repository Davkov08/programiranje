#include <bits/stdc++.h>
using namespace std;
int main() {
    const int N = 100;
    int a[N],x,l,n=N;
    for (int i = 1; i < n; i++) {
        a[i] = i+1;
    }
    //update
    a[N/2] = 100; //O(1)
    //remove
    cin>>x;
    // O(n)
    for (int i = x; i<n-1; i++) {
        a[i] = a[i+1];
    }
    n--;
    //O(n)
    cin>>x>>l;
    if (n<N) {
        for (int i=n-1; i>=l; i--) {
            a[i+1] = a[i];
        }
        a[l] = x;
        n++;
    }

    else if (n==N) {
        int a1[N*2];
        for (int i = 0; i < l; i++) {
            a1[i] = a[i];
        }
        a[l]=x;
        for (int i=l+1; i<n+1; i++) {
            a1[i] = a[i-1];
        }
        n++;
    }

    return 0;
}
