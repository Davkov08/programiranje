#include <bits/stdc++.h>
using namespace std;
int main() {
    ios::sync_with_stdio(NULL);
    cin.tie(NULL);
    long long n,k;
    cin>>n>>k;
    map<long long, long long> m;
    vector<long long> a(n),b(n);
    for (long long i=0;i<n;i++) {
        cin>>a[i];
    }
    for (long long i=0;i<n;i++) {
        cin>>b[i];
    }
    for (long long k=0;k<n;k++) {
        for (long long i=b[k];i<a[k];i++) {
            m[i]++;
        }
    }
    long long sum = 0;
    for (auto [key, value] : m) {
        sum += value;
        if (sum == k) {
            cout<<"DA";
            return 0;
        }
        if (sum>k) {
            sum = 0;
        }
    }
    cout << "NE";
}
